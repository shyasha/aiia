# =============================================================================
# AIIA Clinical Trials Dashboard - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values

# --- Database ---
DATABASE_URL=postgresql+asyncpg://aiia:aiia_dev_password@localhost:5432/aiia_ctms
DATABASE_URL_SYNC=postgresql://aiia:aiia_dev_password@localhost:5432/aiia_ctms
POSTGRES_USER=aiia
POSTGRES_PASSWORD=aiia_dev_password
POSTGRES_DB=aiia_ctms
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change-this-to-a-secure-random-string-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DEBUG=true

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=AIIA Clinical Trials Dashboard

# --- Storage ---
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
# For GCP: STORAGE_BACKEND=gcs
# GCS_BUCKET_NAME=aiia-ctms-documents
# GCS_PROJECT_ID=your-gcp-project

# --- Email (optional - uses console backend by default) ---
EMAIL_BACKEND=console
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- Anthropic AI ---
ANTHROPIC_API_KEY=your-anthropic-api-key-here
